# 商识唯智后端环境变量示例
# 复制本文件为 .env 并填入实际值

# 生产环境请设置为 false
DEBUG=true

# SQLite 数据库路径
DATABASE_URL=sqlite:///./bizsim.db

# 安全密钥：必须是从未泄露过的强随机字符串。
# 生成命令：python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=replace-with-your-production-secret-key

# JWT 访问令牌有效期（分钟），默认 7 天
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 引擎匣子通用 endpoint / token（按需填写）
ENGINE_ENDPOINT=
ENGINE_TOKEN=
